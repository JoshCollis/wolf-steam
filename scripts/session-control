#!/usr/bin/env python3
"""Request an action from this container's Steam session."""
import os
import socket
import sys

action = sys.argv[1] if len(sys.argv) > 1 else 'quit'
if action not in ('quit', 'restart'):
    sys.exit('Supported actions: quit, restart')
with socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM) as client:
    client.connect(os.path.join(os.environ['XDG_RUNTIME_DIR'], 'steam-control.sock'))
    client.send(action.encode())
